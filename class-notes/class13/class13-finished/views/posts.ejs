<div class="all-posts">
      <!-- add the variable that stores your global array in response.render) -->
        <% for(let post of clientPosts) { %>
        <div class="post">
          <%# what is the difference between  ? #%>
          <%# A: = will render the variable normally, plain ejs syntax is just normal js  #%>
            <span class="date"> <%= post.date %></span>
            <% if(post.image) { %>
                <img src="<%=post.image %>">
            <% } %>
            <p class="post-text"><%= post.text %></p>
        </div>
        <% } %>
      </div>